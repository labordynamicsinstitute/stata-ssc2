. clear all

. version 14

. 
. // ---- helper: assert the installed reghdfe.ado starbang contains a string
. capture program drop assert_reghdfe_version

. program define assert_reghdfe_version
  1.     args needle
  2.     quietly findfile reghdfe.ado
  3.     tempname fh
  4.     file open `fh' using `"`r(fn)'"', read text
  5.     file read `fh' line
  6.     file close `fh'
  7.     di as txt `"    installed: `line'"'
  8.     assert strpos(`"`line'"', `"`needle'"') > 0
  9. end

. 
